# Telegram API — get these from https://my.telegram.org > API development tools
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
# Optional for user-session login. Use E.164 format, including country code.
# Example India: TELEGRAM_PHONE=+91XXXXXXXXXX
TELEGRAM_PHONE=
TELEGRAM_SESSION_NAME=session_local
# Use a separate Telethon session per runtime. Local development should not reuse
# the deployed /data/session_name.session file.
SESSION_PATH=data/session_local
# The chat/channel ID the bot monitors for trade signals (negative for groups/channels)
TELEGRAM_TARGET_CHAT_ID=your_target_chat_id_here
# Your own Telegram user ID (get it from @userinfobot)
TELEGRAM_ADMIN_ID=your_telegram_user_id_here

# Persistent SQLite database path. In Azure, use the Azure Files mount.
# DB_PATH=/data/trading_bot.db
DB_PATH=data/trading_bot.db

# OpenAI API (for trade signal parsing)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Groww Accounts (multi-account required)
# Keep secrets in environment/secret manager; do not store in SQLite.
# GROWW_ACCOUNTS_JSON must be a JSON array of account objects.
# GROWW_ACCOUNTS_JSON=[{"account_id":"acc1","display_name":"Account 1","enabled":true,"api_key":"...","api_secret":"...","dry_run":true}]

# Bot Settings
DRY_RUN=True   # Set to False to place REAL trades
INDEX_ORDER_LOTS_COUNT=1
STOCK_ORDER_LOTS_COUNT=1
ORDER_QUANTITY=1  # Fallback only when lot size lookup fails
# Percentage cushion below signal target when placing/modifying OCO target
# Example: 0.02 = 2% (100 -> 98, 5 -> 4.9)
TARGET_BUFFER_PCT=0.02
# Multi-target OCO for single-leg BUY entries (whole lots only)
# Enable to split position across target ladders.
MULTI_TARGET_ENABLED=true
# Two-target split (% of lots): T1:T2 (must sum to 100)
TARGET_SPLIT_2=20:80
# Three-target split (% of lots): T1:T2:T3 (must sum to 100)
TARGET_SPLIT_3=10:20:70
# Tick size for broker price fields (target/SL). Most F&O options use 0.05.
TARGET_PRICE_TICK_SIZE=0.05
# Position sizing mode by segment:
# - fixed: use INDEX_ORDER_LOTS_COUNT / STOCK_ORDER_LOTS_COUNT
# - risk:  size by SL distance + risk budget controls below
INDEX_POSITION_SIZING_MODE=fixed
STOCK_POSITION_SIZING_MODE=risk
# Per-account capital should be set in GROWW_ACCOUNTS_JSON:
# {"account_capital_inr": 500000}
RISK_PCT_PER_TRADE=0.015
MAX_TOTAL_OPEN_RISK_PCT=0.05
INDEX_MIN_LOTS=1
INDEX_MAX_LOTS=15
STOCK_MIN_LOTS=1
STOCK_MAX_LOTS=10
RISK_MODE_ON_ZERO_LOTS=fixed
LOG_LEVEL=INFO

# Wait for price to enter signal range (instead of skipping immediately)
ENTRY_QUEUE_ENABLED=true
ENTRY_QUEUE_POLL_SEC=30
ENTRY_QUEUE_MAX_WAIT_MIN=60
# Advisory message (e.g. LOW QTY/RISKY TRADE) pending override TTL in seconds
SIZE_ADVISORY_TTL_SEC=900

# Single options only: resting LIMIT on exchange + poll order status (false = LTP poll queue only)
ENTRY_SINGLE_LIMIT_ORDER=true
# BUY chase guard when LTP is above entry range max:
# If current R:R >= CHASE_MIN_RR, enter at market; otherwise place RR-based limit.
CHASE_MIN_RR=1.0
# Which target ladder leg to use for chase R:R (1=T1, 2=T2, 3=T3).
CHASE_RR_TARGET_INDEX=2

# Reconcile active_trades.json with broker positions in background
ACTIVE_RECONCILE_ENABLED=true
ACTIVE_RECONCILE_POLL_SEC=60
# Auto re-create OCO for carry-forward positions (set false if broker already keeps OCO overnight)
AUTO_REARM_PROTECTION=false
AUTO_REARM_POLL_SEC=60

# IST schedule: widen OCO SL by VOL_SL_WIDEN_PCT before close, restore to sl_true next morning
VOL_SL_SCHEDULE_ENABLED=false
VOL_SL_WIDEN_TIME_IST=15:15
VOL_SL_RESTORE_TIME_IST=09:25
VOL_SL_WIDEN_PCT=0.10
VOL_SL_SCHEDULE_POLL_SEC=30
VOL_SL_SKIP_WEEKENDS=true

# End-of-day summary from completed_trades/completed_trades_YYYY-MM-DD.json
EOD_SUMMARY_ENABLED=true

# Queue broker management actions (EXIT_ALL / TRAIL_SL / RESTORE_SL / UPDATE_TGT)
MGMT_QUEUE_ENABLED=true
MGMT_QUEUE_POLL_SEC=10
MGMT_QUEUE_MAX_RETRIES=20
MGMT_QUEUE_TTL_MIN=360
MARKET_OPEN_TIME_IST=09:15
MARKET_CLOSE_TIME_IST=15:30
BROKER_WINDOW_PREOPEN_MIN=15
BROKER_WINDOW_POSTCLOSE_MIN=15
GROWW_AUTH_POLL_SEC=60

# Safety guard: when false (default), EXTEND_RANGE for an unknown symbol is rejected
# instead of silently opening a fresh BUY trade. Set true only if you want that behaviour.
EXTEND_RANGE_ALLOWS_ENTRY=false
