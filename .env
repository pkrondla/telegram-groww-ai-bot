# Bot Settings
DRY_RUN=false   # Set to False to place REAL trades
INDEX_ORDER_LOTS_COUNT=1
STOCK_ORDER_LOTS_COUNT=1
ORDER_QUANTITY=1 # Fallback only when lot size lookup fails
# Percentage cushion below signal target when placing/modifying OCO target
# Example: 0.02 = 2% (100 -> 98, 5 -> 4.9)
TARGET_BUFFER_PCT=0.02
TARGET_PRICE_TICK_SIZE=0.05
LOG_LEVEL=INFO

# Wait for price to enter signal range (instead of skipping immediately)
ENTRY_QUEUE_ENABLED=true
ENTRY_QUEUE_POLL_SEC=30
ENTRY_QUEUE_MAX_WAIT_MIN=30

# Single options only: resting LIMIT on exchange + poll order status (false = LTP poll queue only)
ENTRY_SINGLE_LIMIT_ORDER=true
# Reconcile active_trades.json with broker positions in background
ACTIVE_RECONCILE_ENABLED=true
ACTIVE_RECONCILE_POLL_SEC=900
# Auto re-create OCO for carry-forward positions (set false if broker already keeps OCO overnight)
AUTO_REARM_PROTECTION=false
# IST schedule: widen OCO SL by VOL_SL_WIDEN_PCT before close, restore to sl_true next morning
VOL_SL_SCHEDULE_ENABLED=true
VOL_SL_WIDEN_TIME_IST=15:15
VOL_SL_RESTORE_TIME_IST=09:25
VOL_SL_WIDEN_PCT=0.10
VOL_SL_SCHEDULE_POLL_SEC=30
VOL_SL_SKIP_WEEKENDS=false
# End-of-day summary from completed_trades/completed_trades_YYYY-MM-DD.json
EOD_SUMMARY_ENABLED=true
EOD_SUMMARY_TIME_IST=15:30
EOD_SUMMARY_POLL_SEC=1500
EOD_SUMMARY_SKIP_WEEKENDS=true

# Queue broker management actions (EXIT_ALL / TRAIL_SL / RESTORE_SL / UPDATE_TGT)
MGMT_QUEUE_ENABLED=true
MGMT_QUEUE_POLL_SEC=10
MGMT_QUEUE_MAX_RETRIES=5
MGMT_QUEUE_TTL_MIN=360
MARKET_OPEN_TIME_IST=09:15
MARKET_CLOSE_TIME_IST=15:30

# Position sizing mode:
# - fixed: use INDEX_ORDER_LOTS_COUNT / STOCK_ORDER_LOTS_COUNT
# - risk:  size by SL distance + risk budget controls below
# Current mode: risk
POSITION_SIZING_MODE=risk
ACCOUNT_CAPITAL_INR=500000
RISK_PCT_PER_TRADE=0.01
MAX_TOTAL_OPEN_RISK_PCT=0.03
INDEX_MIN_LOTS=1
INDEX_MAX_LOTS=10
STOCK_MIN_LOTS=1
STOCK_MAX_LOTS=6
RISK_MODE_ON_ZERO_LOTS=fixed